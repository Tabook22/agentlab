[Unit]
Description=Agent Lab API
After=network.target

[Service]
WorkingDirectory=%h/apps/agentlab/current/backend
Environment=DATABASE_URL=sqlite:///%h/apps/agentlab/data/agent_lab.db
Environment=OPENAI_API_KEY=
UMask=0077
ExecStartPre=%h/apps/agentlab/current/.venv/bin/python -m alembic upgrade head
ExecStart=%h/apps/agentlab/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8147 --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
