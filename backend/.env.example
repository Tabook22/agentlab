DATABASE_URL=sqlite:///./agent_lab.db
LAB_EVENT_DELAY=0.7
# Local backend credential preparation. Restart the backend after saving.
# Live AI makes billed model calls only when a live mission is explicitly launched.
# Never put this secret in frontend files or VITE_ variables.
OPENAI_API_KEY=

# Optional server-side model configuration (these default rates match gpt-5.4-mini).
OPENAI_MODEL=gpt-5.4-mini
OPENAI_INPUT_USD_PER_MILLION=0.75
OPENAI_OUTPUT_USD_PER_MILLION=4.50

# Ceiling only: missions retain their own allowance until explicit admin approval.
LAB_MAX_MISSION_BUDGET_USD=5.00
